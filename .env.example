# ============================================
# ACON CRM — Variables de entorno (EasyPanel)
# Copia estos valores en Environment del servicio en EasyPanel.
# NUNCA subas un .env con valores reales al repositorio.
# ============================================

# --- Base de datos (MongoDB del compose) ---
MONGO_USER=acon
MONGO_PASSWORD=CAMBIAME_password_largo_y_aleatorio
# (MONGODB_URI se arma solo en el compose con estos dos valores)

# --- Admin inicial ---
# Si no existe ningún admin al arrancar, se crea con estos datos.
# Después del primer arranque puedes borrar estas variables del panel.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIAME_clave_fuerte
# true = al desplegar crea O ACTUALIZA (nombre/clave) el admin con ese email.
# Útil para resetear la clave. Déjalo en false en operación normal.
ADMIN_FORCE_UPDATE=false

# --- Super admin (dueño de la plataforma) ---
# Cuenta con panel propio: costo real de la IA, margen de reventa y cierre de
# periodos. Sus credenciales viven aquí y NO se pueden cambiar desde el CRM.
# Al arrancar se crea o se sincroniza con estos valores. Mínimo 8 caracteres.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Seguridad ---
# Genera uno con: openssl rand -hex 32
JWT_SECRET=CAMBIAME_openssl_rand_hex_32
# Duración de la sesión (1d recomendado; 7d si prefieren loguearse menos)
JWT_EXPIRES_IN=1d
# API key del webhook genérico (Zapier/Make/n8n). Genera otra con: openssl rand -hex 24
WEBHOOK_API_KEY=CAMBIAME_openssl_rand_hex_24
# Cifra las credenciales de integraciones que se guardan desde el panel.
# Genera con: openssl rand -hex 32. NO la cambies después: los valores ya
# guardados quedarían ilegibles y habría que volver a capturarlos.
ENCRYPTION_KEY=CAMBIAME_openssl_rand_hex_32

# --- Dominios (los que configures en EasyPanel) ---
FRONTEND_URL=https://crm.tudominio.com
BACKEND_URL=https://api-crm.tudominio.com

# --- Proveedores de IA (solo el super admin los administra) ---
# La IA se revende al CRM: estas claves nunca se editan desde el panel del
# cliente, solo desde el panel de plataforma o aquí.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# Modelo de chat por defecto; se puede cambiar por agente desde el panel.
OPENAI_MODEL=gpt-4o-mini


# --- Meta / WhatsApp Cloud API ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_WA_TOKEN=
META_WA_PHONE_ID=
# Token de verificación del webhook: invéntalo tú (string aleatorio)
# y pon el mismo en la config del webhook en Meta Developers.
META_WA_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WABA_ID=

# --- Correo saliente ---
# resend = API HTTP de Resend | smtp = servidor SMTP. Vacío: Resend si hay API key.
EMAIL_PROVIDER=
RESEND_API_KEY=
# El dominio del remitente debe estar verificado en Resend
RESEND_FROM=

# --- Email SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_FROM=

# --- Twilio Voice (llamadas desde el navegador) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key estándar (Consola → Account → API keys & tokens)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App cuya Voice URL apunta a {PUBLIC_BASE_URL}/api/calls/voice (POST)
TWILIO_TWIML_APP_SID=
# Número de Twilio con capacidad de voz, en E.164
TWILIO_CALLER_ID=

# --- Google OAuth (Gmail / Calendar, opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe ser: {BACKEND_URL}/api/oauth/google/callback
GOOGLE_REDIRECT_URI=https://api-crm.tudominio.com/api/oauth/google/callback

# --- LinkedIn (opcional) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# --- AWS S3 para adjuntos (opcional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# --- Otros (opcionales) ---
N8N_API_KEY=
BANXICO_TOKEN=
DEFAULT_EXCHANGE_RATE=17.5
